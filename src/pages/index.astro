---
import '../styles/fonts.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/hero-services.css';
import '../styles/hero-header.css';
import '../styles/about-layout.css';
import '../styles/contact-layout.css';
import { Picture } from 'astro:assets';
import Icon from '../components/Icon.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import RotatingEmblem from '../components/RotatingEmblem.astro';
import ServiceGallery from '../components/ServiceGallery.astro';
import { company } from '../data/company';
import hero from '../assets/hero.png';
import technicianCalgary from '../assets/technician-calgary.png';
import companyLogo from '../assets/company-emblem.png';

const site = Astro.site!;
const title = 'Residential & Commercial HVAC Calgary | 17 Mechanical';
const description = 'Residential and commercial HVAC services in Calgary and surrounding areas. Heating, cooling, ventilation, heat pumps and commercial refrigeration. Installation, repairs and maintenance.';
const services = [
  { id: 'heating', label: 'Heating', topic: 'heating', icon: 'heat', name: 'Heating', text: 'Keep your home or business ready for a Calgary winter. Heating solutions built around your property and the people in it.', details: ['Furnaces & rooftop heating', 'Boilers & hydronic systems', 'Heating repairs & replacement'], colour: 'orange' },
  { id: 'ventilation', label: 'Ventilation', topic: 'ventilation', icon: 'wind', name: 'Ventilation & air quality', text: 'A better indoor environment starts with fresh air. Ventilation solutions for homes and commercial spaces.', details: ['Residential & commercial ductwork', 'Fresh air & exhaust systems', 'Airflow & filtration'], colour: 'dark' },
  { id: 'cooling', label: 'Air conditioning', topic: 'cooling', icon: 'snow', name: 'Air conditioning', text: 'Create a comfortable place to work, shop and visit. Cooling solutions for homes and businesses, built around your space and demands.', details: ['Rooftop air conditioning', 'Split & packaged systems', 'Cooling repairs & replacement'], colour: 'blue' },
  { id: 'refrigeration', label: 'Refrigeration', topic: 'refrigeration', icon: 'refrigerator', name: 'Commercial refrigeration', text: 'Keep products at the right temperature and your business running. Refrigeration solutions for restaurants, retail and commercial spaces.', details: ['Walk-in coolers & freezers', 'Commercial refrigeration systems', 'Installation, repairs & maintenance'], colour: 'blue' },
  { id: 'heat-pumps', label: 'Heat pumps', topic: 'heat pumps', icon: 'heatpump', name: 'Heat pumps', text: 'Heat pump installation and service for homes and businesses in Calgary and surrounding areas. Heating and cooling built around your property.', details: ['Heat pump installation & replacement', 'Cold-climate & ductless systems', 'Heat pump service & maintenance'], colour: 'orange' },
];
const faqs = [
  { question: 'Do you work on residential and commercial properties?', answer: 'Yes. We provide heating, ventilation, air conditioning and heat pump services for homes and commercial properties in Calgary and surrounding areas. We also offer commercial refrigeration. Share your property type and system details so we can discuss your project.' },
  { question: 'Do you serve areas outside Calgary?', answer: 'Yes. We serve Calgary and surrounding areas. Tell us your property location when you contact us so we can confirm service availability and plan your visit.' },
  { question: 'Do you offer refrigeration as well as HVAC services?', answer: 'Yes. You can enquire about residential and commercial heating, ventilation, air conditioning and heat pumps, as well as commercial refrigeration, whether you need a repair, equipment replacement or a new installation.' },
  { question: 'Why is preventative HVAC/R maintenance useful?', answer: 'Routine inspections help identify wear, dirty filters and airflow issues before they affect day-to-day operations. A maintenance plan should reflect your equipment, operating hours and building requirements.' },
  { question: 'What should I include in a project enquiry?', answer: 'Include your building location, the type of equipment, what is happening and your preferred timeline. For a new installation, tell us about your space and any available mechanical plans.' },
];
const businessId = new URL('#business', site).href;
const serviceArea = [
  { '@type': 'City', name: 'Calgary', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta, Canada' } },
  { '@type': 'Place', name: company.serviceArea },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'HVACBusiness', '@id': businessId, name: company.name, url: site.href, description, sameAs: [company.instagram, company.googleMaps], areaServed: serviceArea, ...(company.logo ? { logo: new URL(company.logo, site).href } : {}), ...(company.email ? { email: company.email } : {}), ...(company.phone ? { telephone: company.phone.replace(/[^+\d]/g, '') } : {}), contactPoint: { '@type': 'ContactPoint', telephone: company.phone.replace(/[^+\d]/g, ''), email: company.email, contactType: 'customer enquiries' }, hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Residential and commercial HVAC/R services', itemListElement: services.map(service => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.name, serviceType: service.name, provider: { '@id': businessId }, areaServed: serviceArea } })) } },
    { '@type': 'WebSite', '@id': new URL('#website', site).href, url: site.href, name: company.name, inLanguage: 'en-CA', publisher: { '@id': businessId } },
    { '@type': 'FAQPage', '@id': new URL('#faq', site).href, mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#040404" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.href} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.href} />
    <meta property="og:image" content={new URL('/social-preview.jpg', site).href} />
    <meta property="og:image:alt" content="Commercial rooftop HVAC equipment with Calgary skyline" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#home" aria-label={`${company.name} · Calgary — home`}>
          <Picture class="brand-logo" src={companyLogo} alt={company.name} formats={['webp']} fallbackFormat="webp" widths={[50, 62, 96, 124, 186]} sizes="(max-width: 600px) 50px, (max-width: 1100px) 54px, 62px" width={62} quality={70} loading="eager" /><span class="brand-name">17 MECHANICAL <span>HVAC/R LTD. · CALGARY</span></span>
        </a>
        <nav id="navigation" class="navigation" aria-label="Main navigation">
          <a href="#services">Our services</a><a href="#about">About us</a><a href="#maintenance">Maintenance</a><a href="#faq">FAQs</a>
          <a href="#contact">Contact us</a>
        </nav>
        <div class="header-contacts" role="group" aria-label="Contact and social links">
          <a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`} aria-label={`Call ${company.phone}`} title={company.phone}><Icon name="phone" size={21} /></a>
          <a href={`mailto:${company.email}`} aria-label={`Email ${company.email}`} title={company.email}><Icon name="mail" size={21} /></a>
          <a href={company.instagram} target="_blank" rel="noopener noreferrer" aria-label="17 Mechanical on Instagram (opens in a new tab)" title="Instagram"><Icon name="instagram" size={21} /></a>
        </div>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Open navigation"><span></span><span></span></button>
      </div>
    </header>
    <button class="menu-dismiss" type="button" aria-label="Close navigation" tabindex="-1" hidden></button>
    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero-image"><Picture src={hero} alt="Commercial heating pipes, ventilation ducts and rooftop air conditioning overlooking Calgary at dusk" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={60} /></div>
        <div class="hero-shade"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> RESIDENTIAL &amp; COMMERCIAL HVAC/R · CALGARY &amp; AREA</p>
            <h1 id="hero-title">The right climate.<br />For <span>home &amp; business.</span></h1>
            <p class="hero-description">Heating. Ventilation. Air conditioning. Refrigeration.<br />Serving homes and businesses in Calgary &amp; surrounding areas.</p>
            <div class="hero-actions"><a class="button button-orange" href="#contact">Discuss your project <Icon name="diagonal" size={19} /></a><a class="hero-secondary" href="#services">Explore our services <span><Icon name="arrow" size={18} /></span></a></div>
          </div>
        </div>
        <div class="hero-service-bar">
          {services.map(service => <a href={`#${service.id}`} class={`hero-service ${service.colour}`}><Icon name={service.icon} size={54} /><span><b>{service.label}</b></span><Icon name="diagonal" size={36} /></a>)}
        </div>
      </section>

      <div class="intro-strip"><div class="container"><p>Good for your space.<br class="mobile-break" /> <strong>Better for your home or business.</strong></p><span>YOUR SPACE. OUR FOCUS. <Icon name="diagonal" size={19} /></span></div></div>

      <section class="section services-section" id="services" aria-labelledby="services-title">
        <div class="container">
          <div class="section-heading services-heading" data-reveal><div><p class="eyebrow"><span class="little-line"></span> WHAT WE DO</p><h2 id="services-title">Five essentials.<br /><span class="muted">One dependable partner.</span></h2></div><RotatingEmblem /><p class="section-description">From a family home to a commercial property, bring your heating, airflow, cooling, refrigeration and heat pumps together with one team.</p></div>
          <div class="service-grid">
            {services.map((service, index) => <article id={service.id} class={`service-card ${service.colour}`} data-reveal style={`--reveal-delay:${index * 80}ms`}><div class="service-top"><span class="service-icon"><Icon name={service.icon} size={31} /></span><h3>{service.name}</h3></div><p>{service.text}</p><ul>{service.details.map(detail => <li><Icon name="check" size={16} />{detail}</li>)}</ul><a class="service-link" href="#contact" data-service={service.name}>Talk about {service.topic}<Icon name="diagonal" size={20} /></a></article>)}
          </div>
          <ServiceGallery />
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-image" data-reveal><Picture src={technicianCalgary} alt="HVAC technician inspecting rooftop equipment with the Calgary skyline in the background" formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 1080]} sizes="(max-width: 850px) 100vw, 45vw" loading="lazy" quality={60} /><a class="about-photo-credit" href="https://unsplash.com/photos/a-city-with-a-river-running-through-it-Q3hxoJk4Sgw" target="_blank" rel="noopener noreferrer">Skyline: Mahesh Gupta / Unsplash<span class="sr-only"> (opens in a new tab)</span></a><div class="about-image-note"><Icon name="pin" size={20} /><span>LOCAL KNOW-HOW.<br /><b>Calgary &amp; surrounding areas.</b></span></div></div>
          <div class="about-copy" data-reveal><p class="eyebrow"><span class="little-line"></span> MEET {company.name.toUpperCase()}</p><h2 id="about-title">Your building works hard.<br /><span class="muted">So should your HVAC/R.</span></h2><p>Comfort matters at home and at work. We help keep living spaces comfortable and day-to-day business operations moving.</p><p>At {company.name}, we provide residential and commercial heating, ventilation, air conditioning and heat pump services, plus commercial refrigeration, in Calgary and surrounding areas. We start with your building, listen to what you need, and help you take the next step with clarity.</p><div class="about-values"><span><Icon name="check" size={18} /> Homes &amp; businesses</span><span><Icon name="check" size={18} /> Clear communication</span><span><Icon name="check" size={18} /> Practical solutions</span></div><a class="text-link" href="#contact">Let’s get to know your building <Icon name="diagonal" size={21} /></a></div>
        </div>
      </section>

      <section class="section industries-section" aria-labelledby="industries-title">
        <div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="little-line"></span> SPACES WE WORK WITH</p><h2 id="industries-title">Different buildings.<br /><span class="muted">The same attention to detail.</span></h2></div><p class="section-description">Every space has its own demands. Let’s find a mechanical solution that fits yours.</p></div><div class="industry-list" data-reveal>{['Residential homes & multi-family properties', 'Office buildings', 'Retail & commercial spaces', 'Restaurants & hospitality', 'Warehouses & industrial'].map(industry => <a href="#contact"><span class="industry-name">{industry}</span><Icon name="diagonal" size={25} /></a>)}</div></div>
      </section>

      <section class="maintenance-section" id="maintenance" aria-labelledby="maintenance-title">
        <div class="container maintenance-grid"><div data-reveal><p class="eyebrow"><span class="little-line"></span> STAY ONE STEP AHEAD</p><h2 id="maintenance-title">Less downtime.<br />More peace of mind.</h2><p>Make maintenance part of the plan. Regular attention to your HVAC/R and refrigeration equipment can help catch small problems, support system performance and keep your building comfortable through the seasons.</p><a class="button button-white" href="#contact" data-service="Preventative maintenance">Plan your maintenance <Icon name="diagonal" size={19} /></a></div><div class="maintenance-steps" data-reveal><div><h3>Understand your equipment</h3><p>Start with your systems, building needs and operating schedule.</p></div><div><h3>Build a practical plan</h3><p>Set a service schedule around your property and priorities.</p></div><div><h3>Keep things running</h3><p>Inspect, maintain and flag issues for your next decision.</p></div></div></div>
      </section>

      <GoogleReviews />

      <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div data-reveal><p class="eyebrow"><span class="little-line"></span> A FEW HELPFUL ANSWERS</p><h2 id="faq-title">Good questions.<br /><span class="muted">Clear answers.</span></h2><p class="faq-intro">Have something else in mind?<br /><a class="text-link" href="#contact">Let’s talk <Icon name="diagonal" size={17} /></a></p></div><div class="faq-list" data-reveal>{faqs.map(faq => <details name="faq"><summary><h3>{faq.question}</h3><span class="faq-plus"><Icon name="plus" size={20} /></span></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div></div></section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-grid"><div class="contact-copy" data-reveal><p class="eyebrow"><span class="little-line"></span> LET’S BUILD A BETTER ENVIRONMENT</p><h2 id="contact-title">Your next project<br />starts <span>here.</span></h2><p>A repair, a replacement, or something new.<br />Tell us what your home or business needs.</p><div class="contact-details"><span class="contact-area"><Icon name="pin" size={19} />{company.serviceArea}</span>{company.phone && <a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}><Icon name="phone" size={19} />{company.phone}</a>}{company.email && <a href={`mailto:${company.email}`}><Icon name="mail" size={19} />{company.email}</a>}<a href={company.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={19} />@17mechanicalhvac_r<span class="sr-only"> (opens in a new tab)</span></a><a href={company.googleMaps} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={19} />Find us on Google Maps<span class="sr-only"> (opens in a new tab)</span></a></div><div class="contact-brand-line">HEATING <span> / </span> VENTILATION <span> / </span> COOLING <span> / </span> REFRIGERATION</div></div><form class="contact-form" id="enquiry-form" data-email={company.email} action="/api/contact" method="post" data-reveal><h3>Tell us about your project.</h3><div class="form-row"><label>Your name <span>*</span><input name="name" autocomplete="name" placeholder="Full name" required maxlength="100" /></label><label>Email address <span>*</span><input name="email" type="email" autocomplete="email" placeholder="you@company.com" required maxlength="254" /></label></div><div class="form-row"><label>Company (optional)<input name="company" autocomplete="organization" placeholder="Business name, if applicable" maxlength="120" /></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" maxlength="35" /></label></div><label>How can we help? <span>*</span><select name="service" id="enquiry-service" required><option value="" disabled selected>Select a service</option>{services.map(service => <option>{service.name}</option>)}<option>Preventative maintenance</option><option>New installation / other</option></select></label><label>Project details <span>*</span><textarea name="message" rows="3" placeholder="Your property location, what you need, and your ideal timeline…" required maxlength="4000"></textarea></label><div class="form-trap" aria-hidden="true"><label for="enquiry-website">Leave this field empty</label><input id="enquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><div class="form-bottom"><p>Send your request directly to <a href={`mailto:${company.email}`}>{company.email}</a>. We’ll get back to you to discuss your project.</p><button class="button button-orange" type="submit" disabled><span data-submit-label>Send</span> <Icon name="diagonal" size={18} /></button></div><p class="form-status" role="status" aria-live="polite"></p><noscript><p class="form-status">Please enable JavaScript to send your enquiry, or email <a href={`mailto:${company.email}`}>{company.email}</a> directly.</p></noscript></form></div></section>
    </main>
    <footer class="site-footer"><div class="container footer-top"><a class="brand footer-brand" href="#home" aria-label={`${company.name} · Calgary — home`}><Picture class="brand-logo" src={companyLogo} alt={company.name} formats={['webp']} fallbackFormat="webp" widths={[50, 62, 96, 124, 186]} sizes="(max-width: 600px) 50px, (max-width: 1100px) 54px, 62px" width={62} quality={70} loading="lazy" /><span class="brand-name">17 MECHANICAL <span>HVAC/R LTD. · CALGARY</span></span></a><p>A better climate for your home and business.</p><a class="back-top" href="#home">Back to top <Icon name="diagonal" size={18} /></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {company.name}. All rights reserved.</span><span class="footer-policies"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></span><span class="footer-author">Website by <a href="mailto:ruslan.savchuk.dev.ca@gmail.com" title="ruslan.savchuk.dev.ca@gmail.com" aria-label="Ruslan Savchuk — email ruslan.savchuk.dev.ca@gmail.com">Ruslan Savchuk</a></span><span>CALGARY &amp; AREA <span class="footer-dot">●</span> RESIDENTIAL &amp; COMMERCIAL HVAC/R</span></div></footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
