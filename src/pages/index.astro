---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/hero-services.css';
import { Picture } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { company } from '../data/company';
import hero from '../assets/hero.png';
import servicesPhoto from '../assets/services.png';
import technician from '../assets/technician.png';
import companyLogo from '../assets/company-logo.jpeg';

const site = Astro.site!;
const title = `${company.name} | Commercial HVAC in Calgary`;
const description = 'Commercial heating, ventilation and air conditioning in Calgary. Explore HVAC installation, repairs and preventative maintenance for your business.';
const services = [
  { id: 'heating', number: '01', icon: 'heat', name: 'Commercial heating', text: 'Keep your space ready for a Calgary winter. Heating solutions built around your building and the people in it.', details: ['Furnaces & rooftop heating', 'Boilers & hydronic systems', 'Heating repairs & replacement'], colour: 'orange' },
  { id: 'ventilation', number: '02', icon: 'wind', name: 'Ventilation & air quality', text: 'A better indoor environment starts with fresh air. Practical ventilation for the way your business operates.', details: ['Commercial ductwork', 'Fresh air & exhaust systems', 'Airflow & filtration'], colour: 'dark' },
  { id: 'cooling', number: '03', icon: 'snow', name: 'Air conditioning', text: 'Create a comfortable place to work, shop and visit. Commercial cooling that fits your space and demands.', details: ['Rooftop air conditioning', 'Split & packaged systems', 'Cooling repairs & replacement'], colour: 'blue' },
];
const faqs = [
  { question: 'Do you work on commercial properties?', answer: 'This service is focused on commercial spaces in Calgary, including offices, retail spaces, restaurants and industrial buildings. Share your property type and system details so we can discuss the scope of your project.' },
  { question: 'Can you help with both heating and cooling?', answer: 'Yes. You can enquire about commercial heating, ventilation and air conditioning, whether you need a repair, equipment replacement or a new installation.' },
  { question: 'Why is preventative HVAC maintenance useful?', answer: 'Routine inspections help identify wear, dirty filters and airflow issues before they affect day-to-day operations. A maintenance plan should reflect your equipment, operating hours and building requirements.' },
  { question: 'What should I include in a project enquiry?', answer: 'Include your building location, the type of equipment, what is happening and your preferred timeline. For a new installation, tell us about your space and any available mechanical plans.' },
];
const businessId = new URL('#business', site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'HVACBusiness', '@id': businessId, name: company.name, url: site.href, description, areaServed: { '@type': 'City', name: 'Calgary', containedInPlace: { '@type': 'AdministrativeArea', name: 'Alberta, Canada' } }, ...(company.logo ? { logo: new URL(company.logo, site).href } : {}), ...(company.email ? { email: company.email } : {}), ...(company.phone ? { telephone: company.phone } : {}), hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Commercial HVAC services', itemListElement: services.map(service => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.name, serviceType: service.name, provider: { '@id': businessId }, areaServed: 'Calgary, Alberta, Canada' } })) } },
    { '@type': 'WebSite', '@id': new URL('#website', site).href, url: site.href, name: company.name, inLanguage: 'en-CA', publisher: { '@id': businessId } },
    { '@type': 'FAQPage', '@id': new URL('#faq', site).href, mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#040404" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.href} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.href} />
    <meta property="og:image" content={new URL('/social-preview.jpg', site).href} />
    <meta property="og:image:alt" content="Commercial rooftop HVAC equipment with Calgary skyline" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#home" aria-label={`${company.name} home`}>
          <Picture class="brand-logo" src={companyLogo} alt={company.name} formats={['webp']} widths={[96, 144, 192]} sizes="64px" width={62} loading="eager" /><span class="brand-name">17 MECHANICAL<span>HVAC/R LTD. · CALGARY</span></span>
        </a>
        <nav id="navigation" class="navigation" aria-label="Main navigation">
          <a href="#services">Our services</a><a href="#about">About us</a><a href="#maintenance">Maintenance</a><a href="#faq">FAQs</a>
          <a class="button button-dark nav-cta" href="#contact">Let’s talk <Icon name="diagonal" size={17} /></a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Open navigation"><span></span><span></span></button>
      </div>
    </header>
    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero-image"><Picture src={hero} alt="Commercial heating pipes, ventilation ducts and rooftop air conditioning overlooking Calgary at dusk" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={82} /></div>
        <div class="hero-shade"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> COMMERCIAL HVAC · CALGARY, AB</p>
            <h1 id="hero-title">The right climate.<br />For <span>your business.</span></h1>
            <p class="hero-description">Heating. Ventilation. Air conditioning.<br />Built around your building. Focused on your business.</p>
            <div class="hero-actions"><a class="button button-orange" href="#contact">Discuss your project <Icon name="diagonal" size={19} /></a><a class="hero-secondary" href="#services">Explore our services <span><Icon name="arrow" size={18} /></span></a></div>
          </div>
          <div class="hero-caption"><span class="caption-cross">+</span><span>A better environment.<br />From the rooftop down.</span></div>
          <div class="hero-service-bar">
            {services.map(service => <a href={`#${service.id}`} class={`hero-service ${service.colour}`}><Icon name={service.icon} size={69} /><span><span class="hero-service-number">{service.number}</span><b>{service.id === 'cooling' ? 'Air conditioning' : service.id === 'heating' ? 'Heating' : 'Ventilation'}</b></span><Icon name="diagonal" size={48} /></a>)}
          </div>
        </div>
      </section>

      <div class="intro-strip"><div class="container"><p>Good for your building.<br class="mobile-break" /> <strong>Better for your business.</strong></p><span>YOUR SPACE. OUR FOCUS. <Icon name="diagonal" size={19} /></span></div></div>

      <section class="section services-section" id="services" aria-labelledby="services-title">
        <div class="container">
          <div class="section-heading" data-reveal><div><p class="eyebrow"><span class="little-line"></span> WHAT WE DO</p><h2 id="services-title">Three essentials.<br /><span class="muted">One dependable partner.</span></h2></div><p class="section-description">From a single system to an entire commercial property, bring your heating, airflow and cooling together with one team.</p></div>
          <div class="service-grid">
            {services.map((service, index) => <article id={service.id} class={`service-card ${service.colour}`} data-reveal style={`--reveal-delay:${index * 80}ms`}><div class="service-top"><span class="service-icon"><Icon name={service.icon} size={31} /></span><span class="service-number">/ {service.number}</span></div><h3>{service.name}</h3><p>{service.text}</p><ul>{service.details.map(detail => <li><Icon name="check" size={16} />{detail}</li>)}</ul><a class="service-link" href="#contact" data-service={service.name}>Talk about {service.id === 'heating' ? 'heating' : service.id === 'cooling' ? 'cooling' : 'ventilation'}<Icon name="diagonal" size={20} /></a></article>)}
          </div>
          <div class="services-photo" data-reveal><Picture src={servicesPhoto} alt="Silver commercial ventilation ducts, hydronic heating pipes and mechanical equipment" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(max-width: 700px) 100vw, 90vw" loading="lazy" quality={78} /><div class="photo-label"><span class="status-dot"></span> EVERY SYSTEM. WORKING TOGETHER.</div></div>
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-image" data-reveal><Picture src={technician} alt="HVAC technician inspecting commercial rooftop air conditioning equipment" formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 1080]} sizes="(max-width: 850px) 100vw, 45vw" loading="lazy" quality={80} /><div class="about-image-note"><Icon name="pin" size={20} /><span>LOCAL KNOW-HOW.<br /><b>Calgary, Alberta.</b></span></div></div>
          <div class="about-copy" data-reveal><p class="eyebrow"><span class="little-line"></span> MEET {company.name.toUpperCase()}</p><h2 id="about-title">Your building works hard.<br /><span class="muted">So should your HVAC.</span></h2><p>A comfortable building helps people do their best work. It keeps customers at ease and your day-to-day operations moving.</p><p>At {company.name}, our focus is commercial heating, ventilation and air conditioning in Calgary. We start with your building, listen to what you need, and help you take the next step with clarity.</p><div class="about-values"><span><Icon name="check" size={18} /> Commercial focus</span><span><Icon name="check" size={18} /> Clear communication</span><span><Icon name="check" size={18} /> Practical solutions</span></div><a class="text-link" href="#contact">Let’s get to know your building <Icon name="diagonal" size={21} /></a></div>
        </div>
      </section>

      <section class="section industries-section" aria-labelledby="industries-title">
        <div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow"><span class="little-line"></span> SPACES WE WORK WITH</p><h2 id="industries-title">Different buildings.<br /><span class="muted">The same attention to detail.</span></h2></div><p class="section-description">Every space has its own demands. Let’s find a mechanical solution that fits yours.</p></div><div class="industry-list" data-reveal>{['Office buildings', 'Retail & commercial spaces', 'Restaurants & hospitality', 'Warehouses & industrial'].map((industry, i) => <a href="#contact"><span class="industry-index">0{i + 1}</span><span>{industry}</span><Icon name="diagonal" size={25} /></a>)}</div></div>
      </section>

      <section class="maintenance-section" id="maintenance" aria-labelledby="maintenance-title">
        <div class="container maintenance-grid"><div data-reveal><p class="eyebrow"><span class="little-line"></span> STAY ONE STEP AHEAD</p><h2 id="maintenance-title">Less downtime.<br />More peace of mind.</h2><p>Make maintenance part of the plan. Regular attention to your HVAC can help catch small problems, support system performance and keep your building comfortable through the seasons.</p><a class="button button-white" href="#contact" data-service="Preventative maintenance">Plan your maintenance <Icon name="diagonal" size={19} /></a></div><div class="maintenance-steps" data-reveal><div><span>01</span><h3>Understand your equipment</h3><p>Start with your systems, building needs and operating schedule.</p></div><div><span>02</span><h3>Build a practical plan</h3><p>Set a service schedule around your property and priorities.</p></div><div><span>03</span><h3>Keep things running</h3><p>Inspect, maintain and flag issues for your next decision.</p></div></div></div>
      </section>

      <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div data-reveal><p class="eyebrow"><span class="little-line"></span> A FEW HELPFUL ANSWERS</p><h2 id="faq-title">Good questions.<br /><span class="muted">Clear answers.</span></h2><p class="faq-intro">Have something else in mind?<br /><a class="text-link" href="#contact">Let’s talk <Icon name="diagonal" size={17} /></a></p></div><div class="faq-list" data-reveal>{faqs.map((faq, i) => <details name="faq"><summary><span class="faq-number">0{i + 1}</span><h3>{faq.question}</h3><span class="faq-plus"><Icon name="plus" size={20} /></span></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div></div></section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-grid"><div class="contact-copy" data-reveal><p class="eyebrow"><span class="little-line"></span> LET’S BUILD A BETTER ENVIRONMENT</p><h2 id="contact-title">Your next project<br />starts <span>here.</span></h2><p>A repair, a replacement, or something new.<br />Tell us what your building needs.</p><div class="contact-details"><span><Icon name="pin" size={19} /> Calgary, Alberta, Canada</span>{company.phone && <a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}>{company.phone}</a>}{company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}</div><div class="contact-brand-line">HEATING <span> / </span> VENTILATION <span> / </span> COOLING</div></div><form class="contact-form" id="enquiry-form" data-email={company.email} data-company={company.name} data-reveal><h3>Tell us about your project.</h3><div class="form-row"><label>Your name <span>*</span><input name="name" autocomplete="name" placeholder="Full name" required maxlength="100" /></label><label>Email address <span>*</span><input name="email" type="email" autocomplete="email" placeholder="you@company.com" required maxlength="254" /></label></div><div class="form-row"><label>Company<input name="company" autocomplete="organization" placeholder="Business name" maxlength="120" /></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" maxlength="35" /></label></div><label>How can we help? <span>*</span><select name="service" id="enquiry-service" required><option value="" disabled selected>Select a service</option>{services.map(service => <option>{service.name}</option>)}<option>Preventative maintenance</option><option>New installation / other</option></select></label><label>Project details <span>*</span><textarea name="message" rows="3" placeholder="Your building, what you need, and your ideal timeline…" required maxlength="4000"></textarea></label><div class="form-bottom"><p>{company.email ? 'Opens an email draft for you to review and send.' : 'Prepare and download your enquiry. It will not be sent automatically.'}</p><button class="button button-orange" type="submit" disabled>{company.email ? 'Create email enquiry' : 'Prepare enquiry'} <Icon name="diagonal" size={18} /></button></div><p class="form-status" role="status" aria-live="polite"></p><noscript><p class="form-status">Please enable JavaScript to prepare your enquiry.</p></noscript></form></div></section>
    </main>
    <footer class="site-footer"><div class="container footer-top"><a class="brand footer-brand" href="#home" aria-label={`${company.name} home`}><Picture class="brand-logo" src={companyLogo} alt={company.name} formats={['webp']} widths={[96, 144, 192]} sizes="64px" width={62} loading="lazy" /><span class="brand-name">17 MECHANICAL<span>HVAC/R LTD. · CALGARY</span></span></a><p>A better climate for your business.</p><a class="back-top" href="#home">Back to top <Icon name="diagonal" size={18} /></a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {company.name}. All rights reserved.</span><span>CALGARY, AB <span class="footer-dot">●</span> COMMERCIAL HVAC</span></div></footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
