---
import '../styles/fonts.css';
import { company } from '../data/company';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 17 Mechanical</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header><a href="/">17 MECHANICAL <span>HVAC/R LTD. · CALGARY</span></a></header>
    <main><h1>{title}</h1><slot /></main>
    <footer><a href="/">Back to website</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href={`mailto:${company.email}`}>{company.email}</a></footer>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;background:#fff;color:#171717;font-family:'Manrope Variable',sans-serif;line-height:1.8}
  header,main,footer{width:min(820px,calc(100% - 40px));margin-inline:auto}
  header{padding-block:32px;border-bottom:1px solid #ddd}
  header>a{display:inline-block;color:inherit;font-size:21px;font-weight:800;letter-spacing:.04em;text-decoration:none}
  header span{display:block;color:#626262;font-size:12px;font-weight:500}
  main{padding-block:48px 64px}
  h1{font-size:clamp(30px,6vw,46px);letter-spacing:-.04em;line-height:1.2;margin:0 0 32px}
  main :global(h2){font-size:21px;line-height:1.4;margin:32px 0 12px}
  main :global(p){margin:0 0 16px}
  :global(a){color:#064ead;text-underline-offset:3px;overflow-wrap:anywhere}
  :global(a:focus-visible){outline:2px solid #f65607;outline-offset:4px}
  footer{display:flex;flex-wrap:wrap;gap:12px 24px;padding-block:24px;border-top:1px solid #ddd;font-size:13px}
  footer a{display:inline-flex;align-items:center;min-height:44px}
</style>
